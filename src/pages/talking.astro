---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = false;
---

<BaseLayout title="客舍 Slow Pace Studio - 來一場談話">
    <main class="container" style="max-width: 1000px; margin: 0 auto; padding: 40px 20px;">
        <!-- 頂部 SVG 特效標題區 -->
        <section class="wixui-section">
            <div class="title-container">
                <div class="vector-letter letter-1"><p>來</p></div>
                <div class="vector-letter letter-2"><p>一</p></div>
                <div class="vector-letter letter-3"><p>場</p></div>
                <div class="vector-letter letter-4"><p>談</p></div>
                <div class="vector-letter letter-5"><p>話</p></div>
            </div>
            <div style="text-align: center; max-width: 600px;">
                <h2 style="font-size: 15px; font-weight: normal; color: #555; line-height: 1.6;">
                    <br>可以是一本書﹑一篇文﹑一首詩﹑一段文字﹑一齣戲﹑一首歌﹑一個故事﹑一個理由……<br><br>請帶來一起傾談吧。
                </h2>
            </div>
        </section>

        <!-- 管理員新增按鈕 -->
        <div style="text-align: center; margin-bottom: 20px;">
            <button id="open-add-modal-btn" class="admin-btn add-trigger" style="display: none;" onclick="window.openAddModalWithAutoOrder()">➕ 加入全新談話資料</button>
        </div>

        <!-- 談話列表容器 -->
        <div id="events-container" style="width: 100%;">
            <p style="text-align:center;">資料載入中...</p>
        </div>
    </main>

    <!-- 新增談話 Modal -->
    <div id="add-modal" class="modal-overlay">
        <!-- 保持你原本的表單結構 -->
    </div>

    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script>
        const supabaseUrl = 'https://blqlrxqckiuvgevmakbu.supabase.co';
        const supabaseKey = 'sb_publishable_qFXwpuGChVdRwjc9K7prVQ_PgYmlnpG';
        const client = window.supabase ? window.supabase.createClient(supabaseUrl, supabaseKey) : null;

        async function fetchTalksList() {
            const container = document.getElementById('events-container');
            if (!container) return;

            const { data: talks, error } = await client.from('talks').select('*').order('sort_order', { ascending: false });
            if (error || !talks || talks.length === 0) {
                container.innerHTML = "<p style='text-align:center;'>目前沒有談話資料</p>";
                return;
            }

            let htmlString = "";
            talks.forEach((talk, index) => {
                htmlString += `
                    <div style="display: flex; gap: 40px; align-items: flex-start; background: #fff; padding: 25px; border-radius: 12px; margin-bottom: 30px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                        <div style="flex: 1; min-width: 280px;">
                            <a href="/talking/${encodeURIComponent(talk.title)}">
                                <img src="${talk.image_url}" alt="${talk.title}" style="width: 100%; border-radius: 8px; object-fit: cover;" oncontextmenu="return false;" ondragstart="return false;">
                            </a>
                        </div>
                        <div style="flex: 1.5;">
                            <h2 style="margin-top: 0;">
                                <a href="/talking/${encodeURIComponent(talk.title)}" style="text-decoration: none; color: #2c3e2f;">${talk.title}</a>
                            </h2>
                            <p style="color: #444; line-height: 1.8; font-size: 14px;">
                                ${talk.description ? talk.description.substring(0, 150) + '...' : ''}
                            </p>
                            <a href="/talking/${encodeURIComponent(talk.title)}" class="btn" style="display:inline-block; margin-top:15px; background:#404040; color:#fff; padding:8px 20px; text-decoration:none; border-radius:4px; font-size:14px;">閱讀完整談話 &rarr;</a>
                        </div>
                    </div>
                `;
            });
            container.innerHTML = htmlString;

            // 檢查管理員身分
            const { data: { session } } = await client.auth.getSession();
            if (session) {
                const addBtn = document.getElementById('open-add-modal-btn');
                if (addBtn) addBtn.style.display = "inline-block";
            }
        }

        fetchTalksList();
    </script>
</BaseLayout>