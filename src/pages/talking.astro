---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = false;
---

<BaseLayout title="客舍 Slow Pace Studio - 來一場談話">
    <main class="container" style="max-width: 1000px; margin: 0 auto; padding: 40px 20px;">
        <!-- 頂部 SVG 特效標題區 -->
        <section class="wixui-section">
            <div class="title-container">
                <div class="vector-letter letter-1"><svg viewBox="20.001 28.5 160 143"><path d="m178.558 76.544-1.581-13.454c-1.916-16.315-14.204-29.497-30.331-32.545l-3.162-.601a82.6 82.6 0 0 0-30.284-.077l-4.252.78c-15.571 2.86-27.58 15.169-30.213 30.653l-.193-2.846c-.926-13.563-6.845-24.523-14.617-27.057l-4.477-1.458c-5.802-1.894-11.751-1.917-17.553-.077l-5.132 1.629c-7.818 2.479-13.776 13.463-14.702 27.08l-1.223 17.968a363 363 0 0 0 .101 50.73l1.036 14.351c.974 13.525 6.923 24.399 14.687 26.862l5.225 1.66c5.802 1.839 11.751 1.808 17.553-.077l4.579-1.489h.008c7.725-2.517 13.627-13.368 14.601-26.839l.126-1.742c3.075 14.866 14.871 26.548 29.985 29.327l4.454.818a82.8 82.8 0 0 0 30.284-.077l3.356-.632.016.008c16.034-3.024 28.275-16.073 30.3-32.279l1.23-9.885a211 211 0 0 0 .179-50.73Z"></path></svg><p>來</p></div>
                <div class="vector-letter letter-2"><svg viewBox="20.001 27.5 159.998 144.999"><path d="M20.441 36.107c.357 2.838-.167 6.014.689 8.585.561 1.683.05 4.525.129 6.349.156 3.566.57 7.144.787 10.71.208 3.424.303 6.901.601 10.319.123 1.409.672 2.777.967 4.183.621 2.961 1.058 5.945 1.484 8.932.395 2.766 2.092 5.436 3.182 7.956 1.477 3.416 2.697 7.592 5.073 10.572 1.506 1.888 3.576 3.417 5.365 5.018 4.133 3.699 8.347 7.712 13.144 10.547 1.299.768 2.457.743 4.071 1.135 6.436 1.563 12.881 3.008 19.462 3.803 4.397.531 9.254 1.309 13.624.345 4.221-.931 8.711-1.139 13.062-1.542-3.855.465-7.623 1.577-11.519 1.992-3.286.35-6.529.611-9.673 1.584-2.533.784-5.411 1.08-7.744 2.081-1.391.597-2.505 1.691-3.88 2.405-.796.413-1.714.431-2.493.802a7.4 7.4 0 0 0-1.777 1.839 106 106 0 0 1-4.058 4.173c-2.418 2.401-4.607 4.981-6.947 7.448-1.632 1.72-3.578 3.168-5.309 4.8-.476.449-1.014.729-1.483 1.148-1.843 1.646-3.037 4.666-4.406 6.705-.436.649-1.682 2.104-1.956 2.993-.293.95-.126 2.393-.091 3.35.072 1.994.676 3.822.413 5.828 3.851.74 8.399-.008 12.294.049q3.967.015 7.915.405 1.921.198 3.847.109c.716.128.912.244 1.549.423a6.5 6.5 0 0 0 2.57-.4 67 67 0 0 1 6.561-.657c9.803-.806 19.719-.29 29.548-.343 3.493-.019 6.934.274 10.357.989 3.102.648 6.106.477 9.283.477 3.952 0 8.297-.469 12.228-.025q.414.206.831.407 1.392.206 2.797.095c1.653.043 3.148.749 4.756.803.727-1.195.353-3.041.371-4.326.026-1.856.567-3.128.923-4.88.299-1.472-.065-2.185-.61-3.517-.32-.78-.443-1.462-.778-2.217-.245-.553-.713-1.336-.911-.379.208-4.48.676-10.005-2.066-13.357-1.482-1.813-3.067-3.521-4.428-5.433-.572-.804-1.039-1.399-1.794-2.016-2.252-1.84-4.535-3.637-6.926-5.29-1.795-1.241-3.443-2.429-5.407-3.461-1.551-.816-2.867-1.95-4.391-2.798-1.087-.605-1.413-.425-2.505-.501-3.942-.273-7.782-1.493-11.741-1.514-.69-.004-1.376.027-2.058.081q.31-.03.619-.063c13.719-1.528 27.993-3.701 41.841-2.951 1.495.081 1.201-.36 2.285-1.386 3.69-3.492 6.827-7.47 10.24-11.234 1.288-1.421 2.544-3.099 3.988-4.362.212-.185.495-.135.729-.124.476-1.068 1.368-2.013 2.112-2.891 1.977-2.334 3.536-4.9 5.097-7.529 1.399-2.356 2.916-4.656 3.842-7.233 2.263-6.296 2.721-13.09 3.583-19.687.289-2.213.223-4.411.223-6.643V43.164c-.49 1.431-.227-.749.301-3.196.477-2.211 1.041-4.364 1.573-6.538.116-.474.365-1.994.01-2.399-.333-.379-2.453-.74-2.868-.832-.601-.133-1.321-.082-1.882-.34-.202-.093-.248-.403-.5-.514-1.317-.581-2.836-.359-4.242-.354-2.58.009-5.16 0-7.74 0-10.787 0-22.48.935-33.098-1.185-2.18-.435-4.344-.278-6.564-.28-10.159-.006-20.312-.111-30.463.462-5.658.319-11.31.779-16.966 1.003-1.168.046-2.197.59-3.365.834-3.713.775-7.357 1.857-11.084 2.573-4.521.868-9.352.682-13.944.461-6.478-.312-12.703-2.199-19.05-3.342-.539-.097-6.296-1.317-7.325-.45-1.351 1.138-.423 5.94-.284 7.044z"></path></svg><p>一</p></div>
                <div class="vector-letter letter-3"><svg viewBox="39.5 19.999 121 160.001"><path d="M160.5 99.571c0-9.576-4.27-18.152-11.009-23.957 6.739-5.805 11.009-14.381 11.009-23.957 0-17.484-14.216-31.658-31.752-31.658-12.713 0-23.676 7.453-28.748 18.212-5.071-10.76-16.034-18.212-28.748-18.212-17.536 0-31.752 14.173-31.752 31.658 0 9.576 4.27 18.152 11.009 23.957C43.77 81.419 39.5 89.995 39.5 99.571c0 9.811 4.478 18.579 11.505 24.386-7.028 5.807-11.505 14.574-11.505 24.386-39.5 165.827 53.716 180 71.252 180 12.713 0 23.677-7.452 28.748-18.212 5.071 10.76 16.034 18.212 28.748 18.212 17.536 0 31.752-14.174 31.752-31.657 0-9.811-4.478-18.579-11.505-24.386 7.028-5.807 11.505-14.574 11.505-24.386"></path></svg><p>場</p></div>
                <div class="vector-letter letter-4"><svg viewBox="36.5 20 127.001 159.999"><path d="M76.389 20 37.771 52.663 36.5 107.166l7.333 46.313 58.27 26.52 51.914-61.718 9.484-45.923-49.373-47.288L76.39 20Z"></path></svg><p>談</p></div>
                <div class="vector-letter letter-5"><svg viewBox="19.999 19.999 159.999 159.999"><path d="M149.797 119.603a30.6 30.6 0 0 0-6.482.658c-8.192 1.731-16.703-.889-22.625-6.779l-2.806-2.791a15.1 15.1 0 0 1-.012-21.422l2.773-2.759c5.928-5.896 14.449-8.514 22.647-6.775 2.089.443 4.258.672 6.483.662 16.412-.072 29.926-13.325 30.218-29.648.306-17.117-13.708-31.055-30.918-30.744-16.115.291-29.319 13.279-29.783 29.305a30 30 0 0 0 .896 8.242c2.131 8.452-.382 17.394-6.576 23.555l-1.961 1.95a15.28 15.28 0 0 1-10.774 4.439 15.28 15.28 0 0 1-10.774-4.439l-3.382-3.365c-6.011-5.979-8.609-14.6-6.742-22.849.531-2.346.787-4.796.732-7.314-.351-16.116-13.593-29.236-29.796-29.525-17.211-.307-31.225 13.637-30.911 30.758.298 16.248 13.701 29.467 30.038 29.632a30.6 30.6 0 0 0 7.391-.824c8.404-1.999 17.246.541 23.356 6.619l2.176 2.165a15.1 15.1 0 0 1 4.463 10.717v1.801c0 4.02-1.605 7.875-4.463 10.717l-2.219 2.208c-6.104 6.072-14.936 8.615-23.334 6.624a30.6 30.6 0 0 0-7.39-.819c-16.329.176-29.72 13.391-30.018 29.631-.315 17.123 13.7 31.067 30.912 30.76 16.21-.289 29.454-13.422 29.795-29.545.053-2.52-.205-4.97-.737-7.317-1.874-8.255.722-16.885 6.737-22.87l2.486-2.473a15.28 15.28 0 0 1 10.774-4.439h1.811c4.041 0 7.917 1.597 10.775 4.439l1.066 1.06c6.2 6.167 8.709 15.119 6.57 23.577a30.2 30.2 0 0 0-.902 8.244c.454 16.033 13.66 29.033 29.783 29.324 17.211.311 31.226-13.627 30.919-30.745-.293-16.314-13.794-29.564-30.198-29.647z"></path></svg><p>話</p></div>
            </div>
            <div style="text-align: center; max-width: 600px;">
                <h2 style="font-size: 15px; font-weight: normal; color: #555; line-height: 1.6;">
                    <br>可以是一本書﹑一篇文﹑一首詩﹑一段文字﹑一齣戲﹑一首歌﹑一個故事﹑一個理由……<br><br>請帶來一起傾談吧。
                </h2>
            </div>
        </section>

        <!-- 管理員新增按鈕 -->
        <div style="text-align: center; margin-bottom: 20px;">
            <button id="open-add-modal-btn" class="admin-btn add-trigger" style="display: none;" onclick="window.openAddModalWithAutoOrder()">➕ 加入全新談話資料</button>
        </div>

        <!-- 談話列表容器 -->
        <div id="events-container" style="width: 100%;">
            <p style="text-align:center;">資料載入中...</p>
        </div>
    </main>

    <!-- 新增談話 Modal -->
    <div id="add-modal" class="modal-overlay">
        <div class="modal-box">
            <h3 style="margin-top:0; color:#2c3e2f; border-bottom:1px solid #eee; padding-bottom:10px; display:flex; justify-content:space-between; align-items:center;">
                <span>加入全新談話資料</span>
                <span style="cursor:pointer; font-size:20px; color:#aaa;" onclick="toggleAddModal(false)">×</span>
            </h3>
            
            <label style="font-size:12px; color:#777; display:block; margin-top:10px;">活動標題：</label>
            <input type="text" id="new-title" class="editing-input" placeholder="請輸入全新活動的標題">
            
            <label style="font-size:12px; color:#777; display:block; margin-top:5px;">排序權重 (數字越大排在越前面)：</label>
            <input type="number" id="new-sort" class="editing-input" value="1">

            <label style="font-size:12px; color:#777; display:block; margin-top:5px;">活動內容描述：</label>
            <textarea id="new-desc" class="editing-textarea" placeholder="請輸入活動的詳細內容介紹..."></textarea>
            
            <label style="font-size:12px; color:#2c3e2f; font-weight:bold; display:block; margin-top:15px; border-top:1px dashed #ddd; padding-top:10px;">相片提供方式（二選一）：</label>
            
            <div id="new-img-upload-wrapper" style="margin-top: 8px;">
                <span style="font-size:12px; color:#555; display:block; margin-bottom:4px;">方式 A：直接上傳相片檔案</span>
                <input type="file" id="new-file" accept="image/*">
                <span id="new-compress-status" class="compressing-status" style="display:none;">⏳ 正在處理圖片...</span>
            </div>
            
            <div id="new-img-path-wrapper" style="margin-top: 12px;">
                <span style="font-size:12px; color:#555; display:block; margin-bottom:4px;">方式 B：手動輸入相片路徑或外部連結</span>
                <input type="text" id="new-img-path" class="editing-input" placeholder="請輸入相片相對路徑或外部連結 (例如: images/photo.jpg)">
            </div>

            <div>
                <img id="new-preview" class="upload-preview" style="display:none;" />
                <div style="margin-top: 20px; border-top:1px solid #eee; padding-top:15px; text-align:right; display:flex; justify-content:flex-end; gap:10px;">
                    <button class="admin-btn" style="background:#9b9b9b;" onclick="toggleAddModal(false)">取消</button>
                    <button class="admin-btn" style="background:#2c3e2f;" onclick="createNewTalk()">🚀 確定加入資料</button>
                </div>
            </div>
        </div>
    </div>

    <!-- 修改談話 Modal -->
    <div id="edit-modal" class="modal-overlay">
        <div class="modal-box">
            <h3 style="margin-top:0; color:#2c3e2f; border-bottom:1px solid #eee; padding-bottom:10px; display:flex; justify-content:space-between; align-items:center;">
                <span>✏️ 修改談話活動資料</span>
                <span style="cursor:pointer; font-size:20px; color:#aaa;" onclick="toggleEditModal(false)">×</span>
            </h3>
            
            <input type="hidden" id="edit-target-id">

            <label style="font-size:12px; color:#777; display:block; margin-top:10px;">活動標題：</label>
            <input type="text" id="edit-title" class="editing-input">
            
            <label style="font-size:12px; color:#777; display:block; margin-top:5px;">排序權重 (數字越大排在越前面)：</label>
            <input type="number" id="edit-sort" class="editing-input">

            <label style="font-size:12px; color:#777; display:block; margin-top:5px;">活動內容：</label>
            <textarea id="edit-desc" class="editing-textarea"></textarea>
            
            <label style="font-size:12px; color:#2c3e2f; font-weight:bold; display:block; margin-top:15px; border-top:1px dashed #ddd; padding-top:10px;">相片提供方式（二選一 / 不更換請留空）：</label>
            
            <div id="edit-img-upload-wrapper" style="margin-top: 8px;">
                <span style="font-size:12px; color:#555; display:block; margin-bottom:4px;">方式 A：選取新相片覆蓋</span>
                <input type="file" id="edit-file" accept="image/*>
            </div>
            
            <div id="edit-img-path-wrapper" style="margin-top: 12px;">
                <span style="font-size:12px; color:#555; display:block; margin-bottom:4px;">方式 B：手動修改相片路徑或網址</span>
                <input type="text" id="edit-img-path" class="editing-input" placeholder="請輸入相片相對路徑或外部連結">
            </div>

            <img id="edit-preview" class="upload-preview" style="display:none;" />

            <div style="margin-top: 20px; border-top:1px solid #eee; padding-top:15px; text-align:right; display:flex; justify-content:flex-end; gap:10px;">
                <button class="admin-btn" style="background:#9b9b9b;" onclick="toggleEditModal(false)">取消</button>
                <button class="admin-btn" style="background:#2c3e2f;" onclick="saveChangesFromServer()">💾 儲存更新</button>
            </div>
        </div>
    </div>

    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script>
        const supabaseUrl = 'https://blqlrxqckiuvgevmakbu.supabase.co';
        const supabaseKey = 'sb_publishable_qFXwpuGChVdRwjc9K7prVQ_PgYmlnpG';
        const client = window.supabase ? window.supabase.createClient(supabaseUrl, supabaseKey) : null;
        
        // 🛠️ 定義全域常數與變數，供函數呼叫
        window.client = client;
        window.TABLE_NAME = 'talks';
        window.STORAGE_BUCKET_NAME = 'talks'; // 請確保你在 Supabase 建立了一個名叫 talks-images 的 Public Storage Bucket，或是改為你實際的 Bucket 名稱
        
        let talksData = [];
        let selectedNewCompressedFile = null;
        let selectedCompressedFile = null;

        async function fetchTalks() {
            const container = document.getElementById('events-container');
            if (!container) return;

            const { data: talks, error } = await client.from(window.TABLE_NAME).select('*').order('sort_order', { ascending: false });
            if (error || !talks || talks.length === 0) {
                container.innerHTML = "<p style='text-align:center;'>目前沒有談話資料</p>";
                talksData = [];
                return;
            }

            talksData = talks; // 儲存全域資料供編輯與排序使用
            let htmlString = "";
            talks.forEach((talk) => {
                const talkUrl = `/talking/${encodeURIComponent(talk.title)}`;
                
                // 檢查是否為登入狀態，如果是管理員就額外加上編輯按鈕
                const isAdmin = document.getElementById('open-add-modal-btn').style.display !== 'none';
                const adminEditBadge = isAdmin ? `<span class="edit-badge" onclick="event.preventDefault(); openEditModalFromServer(${talk.id})">✏️ 編輯</span>` : '';
                const orderBadge = isAdmin ? `<span class="order-badge">排序: ${talk.sort_order ?? 0}</span>` : '';

                htmlString += `
                    <a href="${talkUrl}" class="talk-card">
                        <h2 class="talk-title">${talk.title} ${orderBadge} ${adminEditBadge}</h2>
                        <div class="talk-line"></div>
                        <div class="talk-img-wrap">
                            <img src="${talk.image_url}" alt="${talk.title}" oncontextmenu="return false;" ondragstart="return false;">
                        </div>
                        <p class="talk-desc">${talk.description || ''}</p>
                    </a>
                `;
            });
            container.innerHTML = htmlString;

            // 檢查管理員身分
            const { data: { session } } = await client.auth.getSession();
            if (session) {
                const addBtn = document.getElementById('open-add-modal-btn');
                if (addBtn) addBtn.style.display = "inline-block";
                // 重新渲染以顯示編輯按鈕
                // fetchTalks() 會再次呼叫，避免無限迴圈這裡就不重複呼叫
            }
        }

// 方式 A：在「新增」視窗選擇圖片時觸發
function handleNewImageUpload(event) {
    const file = event.target.files[0];
    if (file) {
        selectedNewCompressedFile = file;
        const preview = document.getElementById('new-preview');
        if (preview) {
            preview.src = URL.createObjectURL(file);
            preview.style.display = 'block';
        }
    }
}

// 方式 A：在「編輯」視窗選擇圖片時觸發
function handleEditImageUpload(event) {
    const file = event.target.files[0];
    if (file) {
        selectedCompressedFile = file;
        const preview = document.getElementById('edit-preview');
        if (preview) {
            preview.src = URL.createObjectURL(file);
            preview.style.display = 'block';
        }
    }
}

        // 視窗控制
        window.openAddModalWithAutoOrder = function() {
            let maxOrder = 0; 
            if (talksData.length > 0) {
                const orders = talksData.map(t => t.sort_order !== undefined && t.sort_order !== null ? t.sort_order : 0);
                maxOrder = Math.max(...orders);
            }
            document.getElementById('new-sort').value = maxOrder + 1;
            
            document.getElementById('new-title').value = '';
            document.getElementById('new-desc').value = '';
            document.getElementById('new-img-path').value = '';
            const fileInput = document.getElementById('new-file');
            if (fileInput) fileInput.value = '';
            selectedNewCompressedFile = null;
            
            const preview = document.getElementById('new-preview');
            if (preview) preview.style.display = 'none';

            toggleAddModal(true);
        }

        window.toggleAddModal = function(show) {
            const modal = document.getElementById('add-modal');
            if (modal) {
                if (show) modal.classList.add('show');
                else modal.classList.remove('show');
            }
        }

        window.toggleEditModal = function(show) {
            const modal = document.getElementById('edit-modal');
            if (modal) {
                if (show) modal.classList.add('show');
                else modal.classList.remove('show');
            }
        }

        window.openEditModalFromServer = function(id) {
            const talk = talksData.find(t => t.id === id);
            if (!talk) return;

            document.getElementById('edit-target-id').value = id;
            document.getElementById('edit-title').value = talk.title;
            document.getElementById('edit-sort').value = talk.sort_order !== undefined && talk.sort_order !== null ? talk.sort_order : 0;
            document.getElementById('edit-desc').value = talk.description || '';
            document.getElementById('edit-img-path').value = talk.image_url;
            
            const preview = document.getElementById('edit-preview');
            if (preview) {
                preview.src = talk.image_url;
                preview.style.display = 'block';
            }

            const fileInput = document.getElementById('edit-file');
            if (fileInput) fileInput.value = '';
            selectedCompressedFile = null;

            toggleEditModal(true);
        }

        window.createNewTalk = async function() {
            const title = document.getElementById('new-title').value.trim();
            const desc = document.getElementById('new-desc').value.trim();
            const sortVal = parseInt(document.getElementById('new-sort').value);
            const pathInput = document.getElementById('new-img-path').value.trim();

            if (isNaN(sortVal)) { alert('❌ 排序權重必須填入數字！'); return; }
            if (!title) { alert('❌ 請輸入活動標題！'); return; }

            let finalImageUrl = "";

            if (selectedNewCompressedFile) {
                const fileExt = selectedNewCompressedFile.name.split('.').pop() || 'jpg';
                const fileName = `talk_new_${Date.now()}.${fileExt}`;
                const { error: uploadError } = await window.client.storage
                    .from(window.STORAGE_BUCKET_NAME).upload(fileName, selectedNewCompressedFile, { cacheControl: '3600', upsert: true });

                if (uploadError) { alert('相片上傳失敗：' + uploadError.message + '\n(請確認 Supabase 是否已建立名為 talks 的 Public Bucket)'); return; }
                const { data: { publicUrl } } = window.client.storage.from(window.STORAGE_BUCKET_NAME).getPublicUrl(fileName);
                finalImageUrl = publicUrl;
            } else {
                if (!pathInput) { alert('❌ 請上傳相片或輸入相片路徑/外部連結！'); return; }
                finalImageUrl = pathInput;
            }

            const { error: insertError } = await window.client.from(window.TABLE_NAME).insert([
                { title: title, description: desc, image_url: finalImageUrl, sort_order: sortVal }
            ]);

            if (!insertError) {
                alert('🎉 全新談話活動資料已成功加入！');
                toggleAddModal(false); 
                fetchTalks();           
            } else {
                alert('❌ 寫入資料失敗：' + insertError.message);
            }
        }

        window.saveChangesFromServer = async function() {
            const id = parseInt(document.getElementById('edit-target-id').value);
            const newTitle = document.getElementById('edit-title').value.trim();
            const newDesc = document.getElementById('edit-desc').value.trim();
            const newSort = parseInt(document.getElementById('edit-sort').value);
            const pathValue = document.getElementById('edit-img-path').value.trim();
            
            let finalImageUrl = talksData.find(t => t.id === id).image_url;

            if (isNaN(newSort)) { alert('排序欄位必須填入數字！'); return; }
            if (!newTitle) { alert('標題不能為空！'); return; }

            if (selectedCompressedFile) {
                const fileExt = selectedCompressedFile.name.split('.').pop() || 'jpg';
                const fileName = `talk_${id}_${Date.now()}.${fileExt}`;
                const { error: uploadError } = await window.client.storage
                    .from(window.STORAGE_BUCKET_NAME).upload(fileName, selectedCompressedFile, { cacheControl: '3600', upsert: true });

                if (uploadError) { alert('相片上傳失敗: ' + uploadError.message); return; }
                const { data: { publicUrl } } = window.client.storage.from(window.STORAGE_BUCKET_NAME).getPublicUrl(fileName);
                finalImageUrl = publicUrl;
            } else {
                if (!pathValue) { alert('相片路徑不能為空！'); return; }
                finalImageUrl = pathValue;
            }

            const { error } = await window.client
                .from(window.TABLE_NAME)
                .update({ title: newTitle, description: newDesc, image_url: finalImageUrl, sort_order: newSort })
                .eq('id', id);

            if (!error) {
                alert('🎉 談話內容與排序已成功更新！');
                toggleEditModal(false); 
                fetchTalks(); 
            } else {
                alert('❌ 更新失敗：' + error.message);
            }
        }

        // 初始化載入
        fetchTalks();

// 🛠️ 智能壓縮圖片核心函式
function compressImage(file, maxWidth = 1200, quality = 0.8) {
    return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.readAsDataURL(file);
        reader.onload = (event) => {
            const img = new Image();
            img.src = event.target.result;
            img.onload = () => {
                const canvas = document.createElement('canvas');
                let width = img.width;
                let height = img.height;

                // 如果圖片寬度大於設定的最大寬度，等比例縮放
                if (width > maxWidth) {
                    height = Math.round((height * maxWidth) / width);
                    width = maxWidth;
                }

                canvas.width = width;
                canvas.height = height;

                const ctx = canvas.getContext('2d');
                ctx.drawImage(img, 0, 0, width, height);

                // 轉為 Blob 格式 (JPG)
                canvas.toBlob((blob) => {
                    if (!blob) {
                        reject(new Error('圖片壓縮失敗'));
                        return;
                    }
                    // 保持原本的檔名，但副檔名轉為 .jpg
                    const compressedFile = new File([blob], file.name.replace(/\.[^/.]+$/, "") + ".jpg", {
                        type: 'image/jpeg',
                        lastModified: Date.now(),
                    });
                    resolve(compressedFile);
                }, 'image/jpeg', quality);
            };
            img.onerror = (error) => reject(error);
        };
        reader.onerror = (error) => reject(error);
    });
}

document.addEventListener('DOMContentLoaded', () => {
    // 新增談話的圖片上傳監聽
    const newFileInput = document.getElementById('new-file');
    if (newFileInput) {
        newFileInput.addEventListener('change', async (event) => {
            const file = event.target.files[0];
            if (file) {
                const statusEl = document.getElementById('new-compress-status');
                if (statusEl) statusEl.style.display = 'block';

                try {
                    // 執行壓縮（限制最大寬度 1200px，畫質 0.8）
                    selectedNewCompressedFile = await compressImage(file, 1200, 0.8);
                    
                    const preview = document.getElementById('new-preview');
                    if (preview) {
                        preview.src = URL.createObjectURL(selectedNewCompressedFile);
                        preview.style.display = 'block';
                    }
                } catch (err) {
                    console.error('壓縮失敗:', err);
                    selectedNewCompressedFile = file; // 失敗時退回使用原圖
                } finally {
                    if (statusEl) statusEl.style.display = 'none';
                }
            }
        });
    }

    // 編輯談話的圖片上傳監聽
    const editFileInput = document.getElementById('edit-file');
    if (editFileInput) {
        editFileInput.addEventListener('change', async (event) => {
            const file = event.target.files[0];
            if (file) {
                const statusEl = document.getElementById('edit-compress-status');
                if (statusEl) statusEl.style.display = 'block';

                try {
                    selectedCompressedFile = await compressImage(file, 1200, 0.8);
                    
                    const preview = document.getElementById('edit-preview');
                    if (preview) {
                        preview.src = URL.createObjectURL(selectedCompressedFile);
                        preview.style.display = 'block';
                    }
                } catch (err) {
                    console.error('壓縮失敗:', err);
                    selectedCompressedFile = file;
                } finally {
                    if (statusEl) statusEl.style.display = 'none';
                }
            }
        });
    }
});

async function initPage() {
    // 1. 先抓取列表
    await fetchTalks();

    // 2. 檢查 Supabase Session
    const { data: { session }, error } = await client.auth.getSession();
    console.log("目前 Session 狀態：", session); // 可以按 F12 在主控台看是否有資料

    if (session) {
        const addBtn = document.getElementById('open-add-modal-btn');
        if (addBtn) addBtn.style.display = "inline-block";
        
        // 如果有登入，強制把所有編輯按鈕叫出來（重新呼叫一次 fetchTalks 渲染）
        fetchTalks();
    }
}
