---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = false;
---

<BaseLayout title="空間共學 — Slow Pace Studio">
    <section class="hero-section">
        <div class="hero-content">
            <h1>空間共學</h1>
            <p>以空間共學這個模式作為試驗，嘗試連結來自不同空間的人<br>讓大家可以到這裏一起分享、學習。</p>
        </div>
    </section>

    <!-- 管理員新增按鈕 -->
    <div class="study-global-add-wrap" id="studyGlobalAddBlock" style="display:none; justify-content:center; margin:30px auto 10px;">
        <button class="btn-global-add" onclick="window.openCreateModal()">
            <span>➕ 新增展覽與活動項目</span>
        </button>
    </div>

    <main class="container" id="chaptersListContainer">
        <div class="loading-status">正在載入所有篇章清單...</div>
    </main>

    <!-- 管理員新增 Modal -->
    <div class="admin-modal" id="adminModal">
        <div class="admin-modal-content">
            <button class="close-modal-btn" id="closeAdminBtn">&times;</button>
            <h2>新增展覽與活動項目</h2>
            <form id="chapterForm">
                <div class="form-group">
                    <label for="chapterTitle">篇章名稱 *</label>
                    <input type="text" id="chapterTitle" placeholder="例如：大澳篇" required>
                </div>
                <div class="form-group">
                    <label for="chapterBgColor">篇章標題列背景顏色</label>
                    <input type="color" id="chapterBgColor" value="#f5f5f5">
                </div>
                <div class="form-group">
                    <label for="exTitle">展覽名稱 *</label>
                    <input type="text" id="exTitle" required>
                </div>
                <div class="form-group">
                    <label for="exImage">展覽海報圖片網址 *</label>
                    <input type="text" id="exImage" required>
                </div>
                <div class="form-group">
                    <label for="exDesc1">展覽介紹</label>
                    <textarea id="exDesc1" rows="3"></textarea>
                </div>
                <button type="submit" class="form-submit-btn">發布新項目</button>
            </form>
        </div>
    </div>

    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script>
        const supabaseUrl = 'https://blqlrxqckiuvgevmakbu.supabase.co';
        const supabaseKey = 'sb_publishable_qFXwpuGChVdRwjc9K7prVQ_PgYmlnpG';
        const client = supabase.createClient(supabaseUrl, supabaseKey);

        async function fetchChaptersList() {
            const container = document.getElementById('chaptersListContainer');
            try {
                const { data: records, error } = await client.from('chapters').select('title, bg_color, ex_image, ex_title');
                if (error) throw error;
                if (!records || records.length === 0) {
                    container.innerHTML = '<div class="loading-status">目前尚無篇章資料。</div>';
                    return;
                }

                // 依據篇章名稱分組
                const grouped = {};
                records.forEach(r => {
                    if (!grouped[r.title]) grouped[r.title] = r;
                });

                let html = '<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 30px; margin: 40px 0;">';
                Object.values(grouped).forEach(chapter => {
                    html += `
                        <a href="/study/${encodeURIComponent(chapter.title)}" style="text-decoration: none; color: inherit;">
                            <div style="background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05); transition: transform 0.2s;">
                                <img src="${chapter.ex_image}" style="width: 1002px; height: 220px; object-fit: cover;" />
                                <div style="padding: 20px;">
                                    <h3 style="margin: 0 0 10px 0; font-size: 20px; color: #2c2c2c;">${chapter.title}</h3>
                                    <p style="margin: 0; color: #666; font-size: 14px;">點擊進入查看獨立篇章與活動內容 &rarr;</p>
                                </div>
                            </div>
                        </a>
                    `;
                });
                html += '</div>';
                container.innerHTML = html;

                // 檢查管理員身分
                const { data: { session } } = await client.auth.getSession();
                if (session) {
                    document.getElementById('studyGlobalAddBlock').style.display = 'flex';
                }
            } catch (err) {
                container.innerHTML = '<div class="loading-status" style="color: red;">載入失敗。</div>';
            }
        }

        document.getElementById('closeAdminBtn').onclick = () => document.getElementById('adminModal').style.display = 'none';
        window.openCreateModal = () => document.getElementById('adminModal').style.display = 'flex';

        document.getElementById('chapterForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const payload = {
                title: document.getElementById('chapterTitle').value.trim(),
                bg_color: document.getElementById('chapterBgColor').value,
                ex_title: document.getElementById('exTitle').value.trim(),
                ex_image: document.getElementById('exImage').value.trim(),
                ex_desc_1: document.getElementById('exDesc1').value.trim()
            };
            const { error } = await client.from('chapters').insert([payload]);
            if (error) alert('新增失敗：' + error.message);
            else { alert('新增成功！'); window.location.reload(); }
        });

        document.addEventListener('DOMContentLoaded', fetchChaptersList);
    </script>
</BaseLayout>

<style>
    .hero-section { background-image: url('/images/study1.jpg'); background-size: cover; background-position: bottom center; height: 350px; display: flex; align-items: center; justify-content: center; color: #ffffff; text-align: center; max-width: 1500px; margin: 20px auto 0; border-radius: 34px; }
    .hero-content { max-width: 750px; padding: 0 20px; }
    .hero-content h1 { font-size: 38px; margin: 0 0 15px 0; letter-spacing: 3px; font-weight: normal; }
    .hero-content p { font-size: 15px; color: #fff5f0; letter-spacing: 1.2px; margin: 0; }
    .btn-global-add { background-color: #2b73ff; color: #ffffff; border: none; padding: 12px 24px; font-size: 15px; border-radius: 6px; cursor: pointer; }
</style>