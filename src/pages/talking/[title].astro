---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;

const { title } = Astro.params;
const decodedTitle = decodeURIComponent(title || '');

const supabaseUrl = 'https://blqlrxqckiuvgevmakbu.supabase.co';
const supabaseKey = 'sb_publishable_qFXwpuGChVdRwjc9K7prVQ_PgYmlnpG';

// 1. 查詢當前談話資料
const response = await fetch(`${supabaseUrl}/rest/v1/talks?title=eq.${encodeURIComponent(decodedTitle)}&select=*`, {
    headers: {
        'apikey': supabaseKey,
        'Authorization': `Bearer ${supabaseKey}`
    }
});

if (!response.ok) {
    throw new Error('無法取得談話資料');
}

const records = await response.json();
const talk = records[0] || null;

if (!talk) {
    return Astro.redirect('/404');
}

// 2. 抓取所有談話列表（依 sort_order 排序），用來計算上一篇與下一篇
const listResponse = await fetch(`${supabaseUrl}/rest/v1/talks?select=title,id&order=sort_order.desc`, {
    headers: {
        'apikey': supabaseKey,
        'Authorization': `Bearer ${supabaseKey}`
    }
});
const allTalks = listResponse.ok ? await listResponse.json() : [];

// 計算當前項目的前後索引
const currentIndex = allTalks.findIndex((t: { title: string }) => t.title === talk.title);
const prevTalk = currentIndex > 0 ? allTalks[currentIndex - 1] : null;
const nextTalk = currentIndex >= 0 && currentIndex < allTalks.length - 1 ? allTalks[currentIndex + 1] : null;

const formattedContent = talk.description ? talk.description.replace(/\n/g, '<br>') : '';
---

<BaseLayout title={`${talk.title} — 客舍談話`}>
    <main class="container" style="max-width: 1100px; margin: 40px auto; padding: 0 20px;">

        <!-- 主卡片：無顏色、無框線、無預設陰影 -->
        <div class="talk-main-card">
            
            <!-- 管理員修改按鈕行 -->
            <div class="admin-badge-row">
                <div id="admin-action-btns" style="display: none;">
                    <button class="btn-edit" onclick={`window.openEditModal(${talk.id})`}>修改</button>
                </div>
            </div>

            <!-- 頂部標題置中，帶有左右切換按鈕 -->
            <div class="talk-header-wrap">
                <!-- 左切換按鈕 (上一篇) -->
                {prevTalk ? (
                    <a href={`/talking/${encodeURIComponent(prevTalk.title)}`} class="nav-arrow-btn left" title={`上一篇: ${prevTalk.title}`}>
                        ‹
                    </a>
                ) : (
                    <span class="nav-arrow-btn left disabled">‹</span>
                )}

                <h1 class="talk-main-title">{talk.title}</h1>

                <!-- 右切換按鈕 (下一篇) -->
                {nextTalk ? (
                    <a href={`/talking/${encodeURIComponent(nextTalk.title)}`} class="nav-arrow-btn right" title={`下一篇: ${nextTalk.title}`}>
                        ›
                    </a>
                ) : (
                    <span class="nav-arrow-btn right disabled">›</span>
                )}
            </div>

            <!-- 電腦版「左相右字」兩欄式排版區塊 -->
            <div class="talk-detail-grid">
                <!-- 左側：相片 -->
                <div class="talk-detail-img">
                    <img src={talk.image_url} alt={talk.title} oncontextmenu="return false;" ondragstart="return false;" />
                </div>

                <!-- 右側：文字內容 -->
                <div class="talk-detail-text">
                    <Fragment set:html={formattedContent} />
                </div>
            </div>

        </div>
    </main>

    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script>
        const supabaseUrl = 'https://blqlrxqckiuvgevmakbu.supabase.co';
        const supabaseKey = 'sb_publishable_qFXwpuGChVdRwjc9K7prVQ_PgYmlnpG';
        const client = window.supabase ? window.supabase.createClient(supabaseUrl, supabaseKey) : null;

        async function checkAdmin() {
            if (!client) return;
            const { data: { session } } = await client.auth.getSession();
            if (session) {
                const btns = document.getElementById('admin-action-btns');
                if (btns) btns.style.display = 'block';
            }
        }
        checkAdmin();

        window.openEditModal = function(id) {
            alert("準備編輯談話 ID: " + id);
        }
    </script>

    <style>
        /* 主卡片：無顏色、無框線、無預設陰影 */
        .talk-main-card {
            background: transparent;
            border: none;
            box-shadow: none;
            padding: 20px 0;
        }

        .admin-badge-row {
            width: 100%;
            display: flex;
            justify-content: flex-end;
            margin-bottom: 5px;
            min-height: 30px;
        }

        /* 標題置中與左右按鈕設計 */
        .talk-header-wrap {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
            margin-bottom: 40px;
            position: relative;
        }

        .talk-main-title {
            font-size: 32px;
            color: #2c3e2f;
            margin: 0;
            font-weight: normal;
            text-align: center;
        }

        /* 左右切換箭頭按鈕樣式 */
        .nav-arrow-btn {
            font-size: 32px;
            color: #888;
            text-decoration: none;
            padding: 0 10px;
            line-height: 1;
            transition: color 0.2s ease, transform 0.2s ease;
            user-select: none;
        }

        .nav-arrow-btn:hover:not(.disabled) {
            color: #2c3e2f;
            transform: scale(1.15);
        }

        .nav-arrow-btn.disabled {
            color: #ddd;
            cursor: default;
        }

        /* 電腦版「左相右字」兩欄式排版 */
        .talk-detail-grid {
            display: grid;
            grid-template-columns: 1fr 1.2fr;
            gap: 50px;
            align-items: start;
        }

        .talk-detail-img img {
            width: 100%;
            height: auto;
            max-height: 550px;
            object-fit: contain;
            border-radius: 8px;
        }

        .talk-detail-text {
            font-size: 16px;
            line-height: 2;
            color: #333;
            text-align: justify;
            white-space: pre-wrap;
        }

        /* 手機 RWD 響應式：螢幕小於 768px 時改回上下單欄排列 */
        @media (max-width: 768px) {
            .talk-detail-grid {
                grid-template-columns: 1fr;
                gap: 25px;
            }
            .talk-main-title {
                font-size: 22px;
            }
            .nav-arrow-btn {
                font-size: 26px;
                padding: 0 5px;
            }
        }
    </style>
</BaseLayout>