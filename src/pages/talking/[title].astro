---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;

const { title } = Astro.params;
const decodedTitle = decodeURIComponent(title || '');

const supabaseUrl = 'https://blqlrxqckiuvgevmakbu.supabase.co';
const supabaseKey = 'sb_publishable_qFXwpuGChVdRwjc9K7prVQ_PgYmlnpG';

// 1. 查詢當前談話資料
const response = await fetch(`${supabaseUrl}/rest/v1/talks?title=eq.${encodeURIComponent(decodedTitle)}&select=*`, {
    headers: {
        'apikey': supabaseKey,
        'Authorization': `Bearer ${supabaseKey}`
    }
});

if (!response.ok) {
    throw new Error('無法取得談話資料');
}

const records = await response.json();
const talk = records[0] || null;

if (!talk) {
    return Astro.redirect('/404');
}

// 2. 抓取所有談話列表，用來做標題切換選單
const listResponse = await fetch(`${supabaseUrl}/rest/v1/talks?select=title&order=sort_order.desc`, {
    headers: {
        'apikey': supabaseKey,
        'Authorization': `Bearer ${supabaseKey}`
    }
});
const allTalks = listResponse.ok ? await listResponse.json() : [];

const formattedContent = talk.description ? talk.description.replace(/\n/g, '<br>') : '';
---

<BaseLayout title={`${talk.title} — 客舍談話`}>
    <main class="container" style="max-width: 1100px; margin: 40px auto; padding: 0 20px;">

        <!-- 主卡片：無顏色、無框線、無預設陰影 -->
        <div class="talk-main-card">
            
        

            <!-- 頂部標題置中，標題本身即為切換觸發器 -->
            <div class="talk-header-wrap">
                <div class="title-dropdown-container">
                    <h1 class="talk-main-title">
                        {talk.title} <span class="dropdown-arrow">▼</span>
                    </h1>

                    {allTalks.length > 1 && (
                        <select 
                            class="hidden-title-select"
                            onchange="if(this.value) window.location.href='/talking/' + encodeURIComponent(this.value);"
                        >
                            <option value="" disabled selected>切換其他標題</option>
                            {allTalks.map((t: { title: string }) => (
                                <option value={t.title} selected={t.title === talk.title}>{t.title}</option>
                            ))}
                        </select>
                    )}
                </div>
            </div>

            <!-- 電腦版「左相右字」兩欄式排版區塊 -->
            <div class="talk-detail-grid">
                <!-- 左側：相片 -->
                <div class="talk-detail-img">
                    <img src={talk.image_url} alt={talk.title} oncontextmenu="return false;" ondragstart="return false;" />
                </div>

                <!-- 右側：文字內容 -->
                <div class="talk-detail-text">
                    <Fragment set:html={formattedContent} />
                </div>
            </div>

        </div>
    </main>

    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script>
        const supabaseUrl = 'https://blqlrxqckiuvgevmakbu.supabase.co';
        const supabaseKey = 'sb_publishable_qFXwpuGChVdRwjc9K7prVQ_PgYmlnpG';
        const client = window.supabase ? window.supabase.createClient(supabaseUrl, supabaseKey) : null;

        async function checkAdmin() {
            if (!client) return;
            const { data: { session } } = await client.auth.getSession();
            if (session) {
                const btns = document.getElementById('admin-action-btns');
                if (btns) btns.style.display = 'block';
            }
        }
        checkAdmin();

        window.openEditModal = function(id) {
            alert("準備編輯談話 ID: " + id);
        }
    </script>

    <style>
        /* 主卡片：無顏色、無框線、無預設陰影 */
        .talk-main-card {
            background: transparent;
            border: none;
            box-shadow: none;
            padding: 20px 0;
        }

        .admin-badge-row {
            width: 100%;
            display: flex;
            justify-content: flex-end;
            margin-bottom: 5px;
            min-height: 30px;
        }

        /* 標題置中與切換互動設計 */
        .talk-header-wrap {
            display: flex;
            justify-content: center;
            margin-bottom: 40px;
            position: relative;
        }

        .title-dropdown-container {
            position: relative;
            display: inline-block;
            cursor: pointer;
        }

        .talk-main-title {
            font-size: 32px;
            color: #2c3e2f;
            margin: 0;
            font-weight: normal;
            text-align: center;
            transition: color 0.2s ease, opacity 0.2s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .dropdown-arrow {
            font-size: 14px;
            opacity: 0.6;
            transition: transform 0.2s ease;
        }

        /* 滑過標題時的效果 */
        .title-dropdown-container:hover .talk-main-title {
            color: #557a5b;
            opacity: 0.85;
        }

        .title-dropdown-container:hover .dropdown-arrow {
            transform: translateY(2px);
        }

        /* 將下拉選單覆蓋在標題上方，點擊標題即可觸發選單 */
        .hidden-title-select {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            cursor: pointer;
            font-size: 16px;
        }

        /* 電腦版「左相右字」兩欄式排版 */
        .talk-detail-grid {
            display: grid;
            grid-template-columns: 1fr 1.2fr;
            gap: 50px;
            align-items: start;
        }

        .talk-detail-img img {
            width: 100%;
            height: auto;
            max-height: 550px;
            object-fit: contain;
            border-radius: 8px;
        }

        .talk-detail-text {
            font-size: 16px;
            line-height: 2;
            color: #333;
            text-align: justify;
            white-space: pre-wrap;
        }

        /* 手機 RWD 響應式：螢幕小於 768px 時改回上下單欄排列 */
        @media (max-width: 768px) {
            .talk-detail-grid {
                grid-template-columns: 1fr;
                gap: 25px;
            }
            .talk-main-title {
                font-size: 24px;
            }
        }
    </style>
</BaseLayout>