---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="客舍萬事屋 - 委託詳細資訊">
    
    <!-- ==========================================
         🎨 樣式完全獨立區 (Style Section)
         ========================================== -->
    <style is:global>
        .post-detail-container {
            max-width: 48rem;
            margin: 2rem auto;
            background-color: #ffffff;
            border-radius: 1.5rem;
            padding: 1.5rem;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            border: 1px solid #fef3c7;
        }
        @media (min-width: 768px) {
            .post-detail-container { padding: 2.5rem; }
        }

        .post-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 1rem;
            border-bottom: 1px solid #f3f4f6;
        }

        .post-client-info { display: flex; align-items: center; gap: 1rem; }

        .post-emoji-box {
            width: 3.5rem;
            height: 3.5rem;
            border-radius: 9999px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.875rem;
            box-shadow: inset 0 2px 4px rgba(0,0,0,0.06);
        }

        .post-title { font-size: 1.5rem; font-weight: bold; color: #111827; }

        .post-tag {
            font-size: 0.75rem;
            padding: 0.375rem 0.75rem;
            border-radius: 9999px;
            background-color: #fff7ed;
            color: #c2410c;
            font-weight: bold;
        }

        .post-details-text {
            font-size: 1rem;
            color: #374151;
            line-height: 1.75;
            white-space: pre-line;
            margin-top: 1rem;
        }

        .post-reward-box {
            background-color: rgba(254, 243, 199, 0.3);
            border-radius: 1rem;
            padding: 1rem;
            border: 1px solid #fef3c7;
            margin-top: 1.5rem;
        }

        .post-actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 1.5rem;
            margin-top: 1.5rem;
            border-top: 1px solid #f3f4f6;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .btn-complete {
            background-color: #059669;
            color: white;
            font-weight: bold;
            padding: 0.625rem 1rem;
            border-radius: 0.75rem;
            font-size: 0.75rem;
            border: none;
            cursor: pointer;
            transition: background 0.2s;
        }
        .btn-complete:hover { background-color: #047857; }

        .btn-join {
            background-color: #c2410c;
            color: white;
            font-weight: bold;
            padding: 0.625rem 1rem;
            border-radius: 0.75rem;
            font-size: 0.75rem;
            border: none;
            cursor: pointer;
            transition: background 0.2s;
        }
        .btn-join:hover { background-color: #9a3412; }

        /* 彈窗樣式 */
        .modal-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.4); backdrop-filter: blur(4px);
            display: flex; align-items: center; justify-content: center;
            opacity: 0; pointer-events: none; transition: opacity 0.3s ease; z-index: 900;
        }
        .modal-overlay.active { opacity: 1; pointer-events: auto; }
        .modal-card {
            background: white; padding: 25px; border-radius: 16px;
            width: 90%; max-width: 420px; box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        }

        /* 抽離原本留在 JS 中的行內樣式，改用乾淨 CSS 類別 */
        .hero-item-box {
            display: flex; justify-content: space-between; align-items: center;
            background: #f9fafb; padding: 0.625rem; border-radius: 0.75rem; border: 1px solid #f3f4f6;
        }
        .hero-text { font-weight: bold; color: #374151; font-size: 0.75rem; }
        .btn-copy-small {
            font-size: 11px; color: #c2410c; background: #fff7ed;
            padding: 0.25rem 0.5rem; border-radius: 0.5rem; border: 1px solid #ffedd5;
            font-weight: bold; cursor: pointer;
        }
        .post-meta-text { font-size: 0.875rem; color: #6b7280; margin-top: 0.25rem; }
        .post-meta-strong { font-weight: 600; color: #374151; }
        .completed-badge {
            font-size: 0.875rem; font-weight: bold; color: #059669;
            background: #ecfdf5; padding: 0.5rem 1rem; border-radius: 0.75rem;
        }
        .empty-heroes-text {
            font-size: 0.75rem; color: #9ca3af; padding: 1rem 0;
            text-align: center; grid-column: span 2;
        }
        .management-section {
            padding-top: 1.5rem; border-top: 1px solid #f3f4f6; margin-top: 1.5rem;
        }
        .management-title {
            font-size: 0.75rem; font-weight: bold; color: #065f46;
            letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.75rem;
        }
        .heroes-grid {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 0.5rem;
        }
        .locked-box {
            padding: 1.5rem; border-top: 1px solid #f3f4f6; background: #fafaf9;
            border-radius: 1rem; border: 1px dashed #e7e5e4; margin-top: 1rem; text-align: center;
        }
        .locked-title { font-size: 0.75rem; font-weight: bold; color: #44403c; margin-bottom: 0.25rem; }
        .locked-desc { font-size: 11px; color: #9ca3af; margin-bottom: 0.75rem; }
        .locked-input-group { display: flex; gap: 0.5rem; max-width: 280px; margin: 0 auto; }
        .locked-input {
            width: 100%; padding: 0.375rem 0.75rem; background: white;
            border: 1px solid #e5e7eb; border-radius: 0.5rem; font-size: 0.75rem;
        }
        .locked-btn {
            padding: 0.375rem 1rem; background: #1c1917; color: white;
            font-weight: bold; font-size: 0.75rem; border-radius: 0.5rem; border: none; cursor: pointer;
        }
        .reward-label { display: block; font-size: 0.75rem; color: #9ca3af; margin-bottom: 0.125rem; }
        .reward-val { font-weight: bold; color: #92400e; font-size: 0.875rem; }
        .action-count-text { font-size: 0.875rem; color: #4b5563; }
        .action-count-num { color: #111827; font-weight: bold; font-size: 1rem; }
        .modal-title { font-size: 1.125rem; font-weight: bold; margin-bottom: 0.5rem; color: #111827; }
        .modal-desc { font-size: 0.875rem; color: #6b7280; margin-bottom: 1rem; }
        .heroes-select-box {
            display: flex; flex-direction: column; gap: 0.5rem;
            max-height: 200px; overflow-y: auto; margin-bottom: 1.5rem;
        }
        .modal-btn-group { display: flex; justify-content: flex-end; gap: 0.5rem; }
        .btn-cancel-modal {
            padding: 0.5rem 1rem; background: #e5e7eb; border: none;
            border-radius: 0.5rem; cursor: pointer; font-size: 0.75rem;
        }
        .btn-confirm-modal {
            padding: 0.5rem 1rem; background: #059669; color: white;
            border: none; border-radius: 0.5rem; cursor: pointer; font-weight: bold; font-size: 0.75rem;
        }
        .radio-label-none {
            display: flex; align-items: center; gap: 0.75rem;
            background: #f9fafb; padding: 0.75rem; border-radius: 0.75rem; border: 1px solid #e5e7eb; cursor: pointer;
        }
        .radio-label-hero {
            display: flex; align-items: center; gap: 0.75rem;
            background: #ecfdf5; padding: 0.75rem; border-radius: 0.75rem; border: 1px solid #a7f3d0; cursor: pointer;
        }
        .radio-text-title { font-size: 0.75rem; font-weight: bold; color: #374151; }
        .radio-text-sub { font-size: 10px; color: #9ca3af; }
        .radio-hero-title { font-size: 0.75rem; font-weight: bold; color: #064e3b; }
        .radio-hero-sub { font-size: 10px; color: #047857; }
        .page-wrapper { padding: 20px; }
        .back-link-box { max-width: 48rem; margin: 0 auto 1rem auto; }
        .back-link { font-size: 0.875rem; color: #6b7280; text-decoration: none; font-weight: bold; }
        .loading-box { text-align: center; padding: 4rem; color: #9ca3af; }
        .error-box { text-align: center; padding: 4rem; color: #ef4444; }
    </style>

    <!-- Supabase CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- ==========================================
         🏗️ 網頁主體結構 (HTML Structure)
         ========================================== -->
    <div class="page-wrapper">
        <div class="back-link-box">
            <a href="/" class="back-link">← 返回萬事屋大廳</a>
        </div>

        <div id="single-post-render-target">
            <div class="loading-box">正在載入委託內容...</div>
        </div>
    </div>

    <!-- 結案互動彈窗 -->
    <div class="modal-overlay" id="complete-modal">
        <div class="modal-card">
            <h3 class="modal-title">✔️ 確認結案與給分</h3>
            <p class="modal-desc">請選擇是哪位英雄完成了此項委託：</p>
            <input type="hidden" id="complete-post-id">
            <div id="heroes-select-container" class="heroes-select-box"></div>
            <div class="modal-btn-group">
                <button onclick="closeCompleteModal()" class="btn-cancel-modal">取消</button>
                <button onclick="submitCompleteTask()" class="btn-confirm-modal">確認送出結案</button>
            </div>
        </div>
    </div>

    <!-- ==========================================
         ⚡ JavaScript 邏輯控制 (零行內樣式)
         ========================================== -->
    <script>
        const supabaseUrl = 'https://blqlrxqckiuvgevmakbu.supabase.co';
        const supabaseKey = 'sb_publishable_qFXwpuGChVdRwjc9K7prVQ_PgYmlnpG';
        const POSTS_TABLE = 'posts';

        window.client = window.client || (window.supabase ? window.supabase.createClient(supabaseUrl, supabaseKey) : null);
        const client = window.client;

        let posts = [];
        let isAdmin = false;
        let unlockedPosts = {};

        const pathSegments = window.location.pathname.split('/');
        const currentPostId = pathSegments[pathSegments.length - 1] || pathSegments[pathSegments.length - 2];

        async function initPage() {
            if (client) {
                const { data: { session } } = await client.auth.getSession();
                isAdmin = !!session;
            }
            await fetchPostsFromSupabase();
        }

        async function fetchPostsFromSupabase() {
            if (!client) return;
            const { data, error } = await client.from(POSTS_TABLE).select('*');
            if (!error && data) {
                posts = data;
                renderSinglePostView(currentPostId);
            }
        }

        function renderSinglePostView(postId) {
            const post = posts.find(p => String(p.id) === String(postId));
            const targetDiv = document.getElementById('single-post-render-target');
            if (!post || !targetDiv) {
                targetDiv.innerHTML = `<div class="error-box">找不到此筆委託或已被刪除。</div>`;
                return;
            }

            const hList = post.heroeslist || [];
            const isComp = post.iscompleted !== undefined ? post.iscompleted : post.isCompleted;
            const bgClor = post.cardbgcolor || 'bg-amber-50';
            const tTitle = post.tasktitle || '';
            const cName = post.clientname || '';
            const tTag = post.tasktag || '';
            const tDetails = post.taskdetails || '';
            const rwd = post.reward || '';

            const hasAccess = isAdmin || unlockedPosts[postId] || !post.password;

            let actionButtonsHtml = '';
            let managementSectionHtml = '';

            if (isComp) {
                actionButtonsHtml = `<span class="completed-badge">已由 ${post.completed_by_name || '鄰里英雄'} 完成 🏮</span>`;
            } else {
                actionButtonsHtml = `
                    <div style="display:flex; gap:0.5rem;">
                        ${hasAccess ? `<button id="btn-open-complete-modal" class="btn-complete" data-post-id="${post.id}">✔️ 結案給分</button>` : ''}
                        <button id="btn-open-join-detail" class="btn-join" data-post-id="${post.id}">我要接單</button>
                    </div>
                `;
            }

            if (hasAccess) {
                let participantsListHtml = hList.length === 0 
                    ? `<p class="empty-heroes-text">目前尚無接單人，快來成為第一個吧！</p>`
                    : hList.map(person => `
                        <div class="hero-item-box">
                            <span class="hero-text">🥷 英雄：${person.name}</span>
                            <span class="hero-text">📋 聯絡：${person.contact}</span>
                            <button class="btn-copy-small btn-copy-contact" data-contact="${person.contact}">複製</button>
                        </div>
                    `).join('');

                managementSectionHtml = `
                    <div class="management-section">
                        <h3 class="management-title">
                            已接下委託的鄰里人名冊 (${hList.length})
                        </h3>
                        <div class="heroes-grid">${participantsListHtml}</div>
                    </div>
                `;
            } else {
                managementSectionHtml = `
                    <div class="locked-box">
                        <h4 class="locked-title">鄰里人名冊與結案功能已加密</h4>
                        <p class="locked-desc">請輸入發布此案件時設定的「管理密碼」解鎖查看。</p>
                        <div class="locked-input-group">
                            <input type="password" id="inline-pwd-input" placeholder="輸入管理密碼" class="locked-input">
                            <button id="btn-verify-inline-pwd" class="locked-btn" data-post-id="${post.id}">解鎖</button>
                        </div>
                    </div>
                `;
            }

            targetDiv.innerHTML = `
                <div class="post-detail-container">
                    <div class="post-header">
                        <div class="post-client-info">
                            <div class="post-emoji-box ${bgClor}">${post.clientemoji || '🙋‍♂️'}</div>
                            <div>
                                <h1 class="post-title">${tTitle}</h1>
                                <p class="post-meta-text">發起委託：<span class="post-meta-strong">${cName}</span></p>
                            </div>
                        </div>
                        <span class="post-tag">${tTag}</span>
                    </div>
                    
                    <div class="post-details-text">${tDetails}</div>

                    <div class="post-reward-box">
                        <span class="reward-label">💰 額外謝禮</span>
                        <span class="reward-val">${rwd}</span>
                    </div>

                    <div class="post-actions">
                        <div class="action-count-text">已有 <strong class="action-count-num">${hList.length}</strong> 位鄰里人挺身而出</div>
                        ${actionButtonsHtml}
                    </div>

                    ${managementSectionHtml}
                </div>
            `;

            document.getElementById('btn-open-complete-modal')?.addEventListener('click', (e) => {
                openCompleteModal(e.currentTarget.getAttribute('data-post-id'));
            });
            document.getElementById('btn-open-join-detail')?.addEventListener('click', (e) => {
                alert('開啟接單視窗');
            });
            document.getElementById('btn-verify-inline-pwd')?.addEventListener('click', (e) => {
                const pwd = document.getElementById('inline-pwd-input').value;
                if(pwd === post.password) {
                    unlockedPosts[postId] = true;
                    renderSinglePostView(postId);
                } else {
                    alert('密碼錯誤！');
                }
            });
            document.querySelectorAll('.btn-copy-contact').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    navigator.clipboard.writeText(e.currentTarget.getAttribute('data-contact'));
                    alert('已複製聯絡資訊！');
                });
            });

            setTimeout(() => { lucide.createIcons(); }, 100);
        }

        function openCompleteModal(postId) {
            const post = posts.find(p => String(p.id) === String(postId));
            if(!post) return;

            document.getElementById('complete-post-id').value = postId;
            const container = document.getElementById('heroes-select-container');
            container.innerHTML = '';

            const hList = post.heroeslist || [];
            
            const noOneDiv = document.createElement('label');
            noOneDiv.className = "radio-label-none";
            noOneDiv.innerHTML = `
                <input type="radio" name="selected-complete-hero" value="none" checked>
                <div>
                    <p class="radio-text-title">❌ 沒有人完成 / 取消此委託</p>
                    <p class="radio-text-sub">（本案會封存，但不會發放萬事分）</p>
                </div>
            `;
            container.appendChild(noOneDiv);

            hList.forEach((hero, index) => {
                const item = document.createElement('label');
                item.className = "radio-label-hero";
                item.innerHTML = `
                    <input type="radio" name="selected-complete-hero" value="${index}">
                    <div>
                        <p class="radio-hero-title">🥷 英雄：${hero.name}</p>
                        <p class="radio-hero-sub">聯絡管道：${hero.contact}</p>
                    </div>
                `;
                container.appendChild(item);
            });

            document.getElementById('complete-modal').classList.add('active');
        }

        function closeCompleteModal() { 
            document.getElementById('complete-modal').classList.remove('active'); 
        }

        async function submitCompleteTask() {
            const postId = document.getElementById('complete-post-id').value;
            const post = posts.find(p => String(p.id) === String(postId));
            if(!post) return;

            const selectedRadio = document.querySelector('input[name="selected-complete-hero"]:checked');
            if(!selectedRadio) { alert("請選擇一項結案條件。"); return; }

            let cName = null;
            let cContact = null;

            if(selectedRadio.value !== 'none') {
                const heroIndex = parseInt(selectedRadio.value);
                const chosenHero = post.heroeslist[heroIndex];
                cName = chosenHero.name;
                cContact = chosenHero.contact;
            }

            try {
                const { error } = await client
                    .from(POSTS_TABLE)
                    .update({ 
                        iscompleted: true,
                        completed_by_name: cName,
                        completed_by_contact: cContact
                    })
                    .eq('id', postId);
                
                if (error) throw error;
                
                closeCompleteModal();
                await fetchPostsFromSupabase();
                if(cName) {
                    alert(`🏮 結案成功！恭喜【${cName}】獲得了 1 點萬事分！`);
                } else {
                    alert("🏮 委託已關閉結案。");
                }
            } catch (err) { alert("更新結案狀態失敗: " + err.message); }
        }

        window.addEventListener('DOMContentLoaded', initPage);
    </script>

</BaseLayout>