            });

            let postTagsSet = new Set();
            baseFilteredPosts.forEach(post => {
                if (post.tasktag) {
                    post.tasktag.trim().split(/\s+/).forEach(t => postTagsSet.add(t.startsWith('#') ? t : `#${t}`));
                }
            });

            if (filterBarContainer && baseFilteredPosts.length > 0) {
                filterBarContainer.classList.remove('hidden');
                let filterHtml = `
                    <div style="width: 100%; display: flex; gap: 8px; overflow-x: auto; padding-bottom: 5px; white-space: nowrap;">
                        <button class="filter-tag-btn" data-tag="all" style="padding: 6px 16px; font-size: 0.85rem; border-radius: 16px; border: 1px solid #ddd; background: ${currentTagFilter === 'all' ? '#333' : '#fff'}; color: ${currentTagFilter === 'all' ? '#fff' : '#333'}; cursor: pointer;">全部顯示</button>
                `;
                postTagsSet.forEach(tag => {
                    const isActive = currentTagFilter === tag;
                    filterHtml += `<button class="filter-tag-btn" data-tag="${tag}" style="padding: 6px 16px; font-size: 0.85rem; border-radius: 16px; border: 1px solid #ddd; background: ${isActive ? '#333' : '#fff'}; color: ${isActive ? '#fff' : '#333'}; cursor: pointer;">${tag}</button>`;
                });
                filterHtml += `</div>`;
                filterBarContainer.innerHTML = filterHtml;
            } else if (filterBarContainer) {
                filterBarContainer.classList.add('hidden');
            }

            const filteredPosts = baseFilteredPosts.filter(post => {
                if (currentTagFilter === 'all') return true;
                const tText = post.tasktag || '';
                return tText.includes(currentTagFilter.replace('#', ''));
            });

            if (filteredPosts.length === 0) {
                container.innerHTML = '<p class="container-empty-hint">此分類目前沒有符合此標籤的委託案件。</p>';
                return;
            }

            filteredPosts.forEach(post => {
                const hList = post.heroeslist || [];
                const count = hList.length;
