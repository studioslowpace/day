<script>
    
    const supabaseUrl = 'https://blqlrxqckiuvgevmakbu.supabase.co';
    const supabaseKey = 'sb_publishable_qFXwpuGChVdRwjc9K7prVQ_PgYmlnpG';
    const TABLE_NAME = 'skills';
    const POSTS_TABLE = 'posts';
    
    const supabaseInstance = window.supabase || supabase;
    const client = supabaseInstance.createClient(supabaseUrl, supabaseKey);
    
    let posts = [];
    let skills = [];
    let isAdmin = false;
    let currentViewingPostId = null;
    let currentTab = 'active';
    let unlockedPosts = {};
    let allUserRecords = [];
    let currentTagFilter = 'all';

window.onload = async function() {
    fetchPostsFromSupabase();
    fetchSkillsFromSupabase(); 
    fetchAllUserRecordsFromSupabase();
    setupRandomDefaultAvatar();

    initEventListeners();

    // 🌟 1. 網頁一載入就「主動」檢查一次目前的登入狀態（解決時間差問題）
    try {
        const { data: { session } } = await client.auth.getSession();
        if (session?.user) {
            const { data: profile, error } = await client
                .from('profiles')
                .select('is_admin')
                .eq('id', session.user.id)
                .single();

            if (!error && profile && profile.is_admin === true) {
                isAdmin = true;
            } else {
                isAdmin = false;
            }
        } else {
            isAdmin = false;
        }
    } catch (err) {
        console.error("檢查初始登入狀態失敗:", err);
        isAdmin = false;
    }
    
    updateAdminUI();
    refreshView();

    // 🌟 2. 持續監聽後續的登入、登出動作
    client.auth.onAuthStateChange(async (event, session) => {
        if (session?.user) {
            const { data: profile, error } = await client
                .from('profiles')
                .select('is_admin')
                .eq('id', session.user.id)
                .single();

            if (!error && profile && profile.is_admin === true) {
                isAdmin = true;
            } else {
                isAdmin = false;
            }
        } else {
            isAdmin = false;
        }
        updateAdminUI();
        refreshView();
    });
};

    function initEventListeners() {
        document.getElementById('banner-logo-trigger')?.addEventListener('click', toggleAdminNavbar);
        document.getElementById('btn-admin-close-nav')?.addEventListener('click', toggleAdminNavbar);
        document.getElementById('btn-admin-login')?.addEventListener('click', handleAdminLogin);
        document.getElementById('btn-admin-logout')?.addEventListener('click', handleAdminLogout);
        document.getElementById('btn-admin-point-plus')?.addEventListener('click', () => adminAdjustPoints(1));
        document.getElementById('btn-admin-point-minus')?.addEventListener('click', () => adminAdjustPoints(-1));

        document.getElementById('header-chatroom-btn')?.addEventListener('click', () => {
            window.open('https://studioslowpace.com/chatroom.html', '_blank');
        });
        document.getElementById('header-skill-btn')?.addEventListener('click', openSkillModal);
        document.getElementById('header-upload-btn')?.addEventListener('click', openUploadModal);

        document.querySelectorAll('.tabs-row .tab-btn').forEach(btn => {
