---
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;

// 1. 在建置時從 Supabase 抓取所有 chapters 資料，並找出所有不重複的篇章名稱
export async function getStaticPaths() {
  const supabaseUrl = 'https://blqlrxqckiuvgevmakbu.supabase.co';
  const supabaseKey = 'sb_publishable_qFXwpuGChVdRwjc9K7prVQ_PgYmlnpG';
  const tableName = 'chapters';

  const response = await fetch(`${supabaseUrl}/rest/v1/${tableName}?select=*,carousel_slides(*)&order=created_at.asc`, {
    headers: {
      'apikey': supabaseKey,
      'Authorization': `Bearer ${supabaseKey}`
    }
  });

  if (!response.ok) return [];
  const records = await response.json();

  // 找出所有不重複的 title (篇章名稱)
  const uniqueTitles = [...new Set(records.map(r => r.title ? r.title.trim() : ''))].filter(Boolean);

  // 為每一個篇章標題建立獨立的分頁
  return uniqueTitles.map(chapterTitle => {
    // 篩選出屬於這個篇章的所有項目（例如大澳篇底下的多個展覽）
    const chapterItems = records.filter(r => r.title && r.title.trim() === chapterTitle);

    return {
      params: { title: chapterTitle },
      props: { 
        chapterTitle, 
        chapterItems 
      }
    };
  });
}

// 2. 接收傳進來的資料
const { chapterTitle, chapterItems } = Astro.props;
const bgCol = chapterItems[0]?.bg_color || '#f5f5f5';
---

<BaseLayout title={`${chapterTitle} — 空間共學`}>
    <main class="container" id="chapterDetailPage">
        <div class="chapter-header-wrap" style={`background-color: ${bgCol};`}>
            <div class="chapter-title"><h2>{chapterTitle}</h2></div>
            <a href="/study" class="btn" style="font-size:13px; padding:6px 16px;">&larr; 返回共學總覽</a>
        </div>

        {chapterItems.map((item, index) => (
            <div>
                {index > 0 && <hr class="inner-item-divider" />}
                
                <div class="exhibition-block">
                    <div class="exhibition-image">
                        <img src={item.ex_image || ''} alt={item.ex_title} oncontextmenu="return false;" ondragstart="return false;" />
                    </div>
                    <div class="exhibition-text">
                        <h3 style="display:flex; justify-content:space-between; align-items:center;">
                            <span>{item.ex_title}</span>
                            <!-- 管理員修改/刪除按鈕 (透過前端 JS 判斷登入顯示) -->
                            <div class="action-btns" data-item-id={item.id} style="display:none; gap:10px;">
                                <button class="btn-edit" onclick={`window.openEditModal(${item.id})`}>修改</button>
                                <button class="btn-delete" onclick={`window.deleteItem(${item.id})`}>刪除</button>
                            </div>
                        </h3>
                        {item.ex_desc_1 && <p>{item.ex_desc_1}</p>}
                        {item.ex_desc_2 && <p>{item.ex_desc_2}</p>}
                        <p class="date">{item.ex_date || ''}</p>
                        {item.ex_link && (
                            <a href={item.ex_link} class="btn" target="_blank">相關連結 / 展覽作品 <span class="arrow">&rarr;</span></a>
                        )}
                    </div>
                </div>

                {(item.tour_title || (item.carousel_slides && item.carousel_slides.length > 0)) && (
                    <div class="tour-block">
                        {item.tour_title && <h4>{item.tour_title}</h4>}
                        {item.carousel_slides && item.carousel_slides.length > 0 && (
                            <div class="carousel-container">
                                <div class="carousel-counter"></div>
                                <button class="carousel-btn prev-btn">&#10094;</button>
                                <button class="carousel-btn next-btn">&#10095;</button>
                                <div class="carousel-wrapper">
                                    {item.carousel_slides.sort((a,b) => a.sort_order - b.sort_order).map(slide => (
                                        <div class="carousel-slide">
                                            <img src={slide.image_url} alt="照片" oncontextmenu="return false;" ondragstart="return false;" />
                                            {slide.caption && <p class="carousel-caption">{slide.caption}</p>}
                                        </div>
                                    ))}
                                </div>
                            </div>
                        )}
                    </div>
                )}
            </div>
        ))}
    </main>

    <!-- 載入 Supabase 讓前端點擊修改/刪除或登入時同步生效 -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script>
        const supabaseUrl = 'https://blqlrxqckiuvgevmakbu.supabase.co';
        const supabaseKey = 'sb_publishable_qFXwpuGChVdRwjc9K7prVQ_PgYmlnpG';
        const client = window.supabase ? window.supabase.createClient(supabaseUrl, supabaseKey) : null;

        // 檢查管理員身分以顯示編輯按鈕
        async function initAuthCheck() {
            if (!client) return;
            const { data: { session } } = await client.auth.getSession();
            if (session) {
                document.querySelectorAll('.action-btns').forEach(el => el.style.display = 'flex');
            }
        }
        initAuthCheck();

        // 輪播初始化指令碼...
        document.querySelectorAll('.carousel-container').forEach(container => {
            const wrapper = container.querySelector('.carousel-wrapper');
            const counter = container.querySelector('.carousel-counter');
            const prevBtn = container.querySelector('.prev-btn');
            const nextBtn = container.querySelector('.next-btn');
            const slides = container.querySelectorAll('.carousel-slide');
            if (slides.length <= 1) { if(prevBtn) prevBtn.style.display='none'; if(nextBtn) nextBtn.style.display='none'; return; }
            
            let currentIndex = 0; const total = slides.length;
            function update() { 
                wrapper.style.transform = `translateX(-${currentIndex * 100}%)`; 
                if (counter) counter.textContent = `${currentIndex + 1} / ${total}`; 
            }
            if(nextBtn) nextBtn.onclick = (e) => { e.stopPropagation(); currentIndex = (currentIndex + 1) % total; update(); };
            if(prevBtn) prevBtn.onclick = (e) => { e.stopPropagation(); currentIndex = (currentIndex - 1 + total) % total; update(); };
            update();
        });
    </script>
</BaseLayout>

<style>
    /* 保持你原本精美的 CSS 樣式 */
    .chapter-section { padding: 40px 25px; border-radius: 16px; margin-bottom: 60px; background-color: #ffffff; box-shadow: 0 2px 15px rgba(0,0,0,0.02); }
    .chapter-header-wrap { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin: 10px 0 30px; padding: 15px 30px; border-radius: 12px; }
    .chapter-title h2 { font-size: 26px; color: #2c2c2c; font-weight: 500; margin: 0; }
    .inner-item-divider { border: 0; border-top: 4px solid #aecfe5; margin: 40px 0; }
    .exhibition-block { display: flex; gap: 50px; margin-bottom: 30px; align-items: flex-start; white-space: pre-wrap; }
    .exhibition-image { flex: 1; min-width: 320px; }
    .exhibition-image img { width: 100%; border-radius: 8px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); }
    .exhibition-text { flex: 1.4; }
    .exhibition-text h3 { font-size: 22px; margin-top: 0; margin-bottom: 15px; color: #2c2c2c; font-weight: normal; }
    .exhibition-text p { font-size: 15px; margin-bottom: 12px; text-align: justify; color: #4a4a4a; }
    .exhibition-text .date { font-weight: 500; margin: 15px 0; color: #666666; font-size: 14px; }
    .btn { display: inline-flex; align-items: center; background-color: #404040; color: #ffffff; text-decoration: none; padding: 10px 28px; font-size: 14px; border-radius: 4px; transition: background 0.3s; }
    .btn:hover { background-color: #1a1a1a; }
    .btn .arrow { margin-left: 10px; }
    .tour-block { margin-top: 45px; margin-bottom: 15px; }
    .tour-block h4 { font-size: 18px; margin-bottom: 20px; text-align: center; font-weight: normal; color: #444; letter-spacing: 1px; }
    .action-btns { display: flex; gap: 10px; }
    .btn-edit, .btn-delete { background: rgba(255, 255, 255, 0.9); border: 1px solid rgba(0, 0, 0, 0.15); padding: 6px 14px; font-size: 13px; color: #404040; cursor: pointer; border-radius: 4px; }
    .btn-edit:hover { border-color: #404040; background: #ffffff; }
    .btn-delete:hover { border-color: #ff4d4f; color: #ff4d4f; background: #fff1f0; }

    /* 相片輪播樣式 */
    .carousel-container { position: relative; max-width: 860px; margin: 0 auto; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.08); border-radius: 8px; background-color: #1a1a1a; }
    .carousel-wrapper { display: flex; transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1); width: 100%; }
    .carousel-slide { min-width: 100%; position: relative; }
    .carousel-slide img { width: 100%; height: 520px; object-fit: contain; background-color: #1a1a1a; }
    .carousel-counter { position: absolute; top: 25px; right: 35px; background: rgba(0, 0, 0, 0.4); color: #ffffff; padding: 4px 14px; font-size: 13px; border-radius: 20px; z-index: 10; }
    .carousel-caption { position: absolute; bottom: 0; left: 0; right: 0; margin: 0; padding: 25px 100px 25px 35px; background: rgba(0, 0, 0, 0.6); color: #ffffff; font-size: 14px; z-index: 5; }
    .carousel-btn { position: absolute; top: calc(50% - 22px); background: rgba(255, 255, 255, 0.85); border: none; width: 44px; height: 44px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; z-index: 10; }
    .prev-btn { left: 20px; } .next-btn { right: 20px; }
</style>