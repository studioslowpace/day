    .auth-form-group input { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px; text-align: center; box-sizing: border-box; }
    #globalSearchInput { text-align: left; }
    .auth-btn-group { display: flex; justify-content: space-between; margin-top: 20px; gap: 10px; }
    .auth-btn { flex: 1; padding: 10px; border: none; border-radius: 4px; cursor: pointer; font-size: 14px; }
    .auth-btn-cancel { background: #eee; color: #333; }
    .auth-btn-submit { background: #1465A3; color: white; }

    @media (max-width: 768px) {
        .header-navbar-container { padding: 10px 15px; width: 100%; box-sizing: border-box; }
        .header-logo-area { width: 100%; display: flex; justify-content: space-between; align-items: center; }
        .menu-toggle { 
            display: block !important; font-size: 2rem !important; color: #333333 !important; background: #ffffff !important; 
            padding: 5px 10px !important; border-radius: 6px !important; border: none !important; cursor: pointer !important;
        }
        .header-nav-links {
            display: none; 
            flex-direction: column; 
            position: absolute; 
            top: 100%; 
            left: 0; 
            width: 100vw; 
            max-width: 100vw;
            box-sizing: border-box;
            background: #fff; 
            padding: 20px; 
            box-shadow: 0 4px 6px rgba(0,0,0,0.1); 
            text-align: center; 
            z-index: 9999; 
            gap: 20px;
            margin: 0;
        }
        .menu-toggle:hover { color: #1465A3; }
        .header-nav-links.active { display: flex; }
        .search-icon-btn { justify-content: center; width: 100%; font-size: 1.2rem; padding: 10px 0; }
    }
</style>

<script>
    declare global {
        interface Window {
            supabase: any;
            client: any;
        }
    }

    const supabaseUrl = 'https://blqlrxqckiuvgevmakbu.supabase.co';
    const supabaseKey = 'sb_publishable_qFXwpuGChVdRwjc9K7prVQ_PgYmlnpG';
    window.client = window.client || (window.supabase ? window.supabase.createClient(supabaseUrl, supabaseKey) : null);

    const setupHeaderAuth = () => {
        const authBtn = document.getElementById('auth-btn');
        const passwordModal = document.getElementById('passwordModal');
        const closePasswordModalBtn = document.getElementById('closePasswordModalBtn');
        const verifyPasswordBtn = document.getElementById('verifyPasswordBtn');
        const adminPwdInput = document.getElementById('adminPwd') as HTMLInputElement | null;
        const body = document.body;

        if (!authBtn || !passwordModal || !window.client) return;

        const checkGlobalLoginState = async () => {
            const { data: { session } } = await window.client.auth.getSession();
            const addBlock = document.getElementById('clubGlobalAddBlock');
            
            if (session) {
                authBtn.classList.add('logged-in');
                body.classList.add('admin-mode-active');
                if (addBlock) addBlock.style.display = 'flex';
                authBtn.title = "管理員已登入 (點擊登出)";
            } else {
                authBtn.classList.remove('logged-in');
                body.classList.remove('admin-mode-active');
                if (addBlock) addBlock.style.display = 'none';
                authBtn.title = "管理員登入";
            }
        };

        authBtn.addEventListener('click', async () => {
            const { data: { session } } = await window.client.auth.getSession();
            if (session) {
                if (confirm("確定要登出管理員模式嗎？")) {
                    await window.client.auth.signOut();
                    alert("🔒 已安全登出管理員模式");
                    checkGlobalLoginState();
                    window.location.reload();
                }
            } else {
                passwordModal.style.display = 'flex';
                if (adminPwdInput) adminPwdInput.focus();
            }
        });

        const closeModal = () => {
            passwordModal.style.display = 'none';
            if (adminPwdInput) adminPwdInput.value = '';
        };
        if (closePasswordModalBtn) closePasswordModalBtn.onclick = closeModal;

        const verifyAdminPassword = async () => {
            if (!adminPwdInput) return;
            const pwd = adminPwdInput.value.trim();
            if (!pwd) return;

            const formattedEmail = `${pwd}@studio.local`;
            const { error } = await window.client.auth.signInWithPassword({ email: formattedEmail, password: pwd });
            
            if (error) {
                alert("❌ 通行密碼錯誤，拒絕存取。");
            } else {
                closeModal();
                alert("🔓 驗證成功！已開啟管理員權限。");
                await checkGlobalLoginState();
                window.location.reload();
            }
        };

        if (verifyPasswordBtn) verifyPasswordBtn.onclick = verifyAdminPassword;
        if (adminPwdInput) {
            adminPwdInput.onkeydown = (e) => { if (e.key === 'Enter') verifyAdminPassword(); };
        }

        checkGlobalLoginState();
    };

   const setupHeaderMenu = () => {
        const toggleButton = document.querySelector('.menu-toggle') as HTMLButtonElement | null;
        const navLinks = document.querySelector('.header-nav-links') as HTMLElement | null;

        if (toggleButton && navLinks) {
            toggleButton.onclick = function(e) {
                navLinks.classList.toggle('active');
                e.stopPropagation();
            };
            document.addEventListener('click', function(e) {
                const target = e.target as HTMLElement;
                if (navLinks.classList.contains('active') && !navLinks.contains(target) && target !== toggleButton) {
                    navLinks.classList.remove('active');
                }
            });
        }

        const mainNav = document.querySelector('.header-nav-links') as HTMLElement | null;
        if (!mainNav) return;

        let moreMenu = document.getElementById('more-menu') as HTMLElement | null;
        let overflowLinks = document.getElementById('overflow-links') as HTMLElement | null;
        const searchBtn = document.getElementById('global-search-btn');
        const allLinks = Array.from(mainNav.children).filter(el => el !== moreMenu && el !== searchBtn && el.tagName === 'A') as HTMLElement[];

        const adjustNavItems = () => {
            if (!mainNav || !moreMenu || !overflowLinks) return;
            if (window.innerWidth <= 768) {
                allLinks.forEach(item => mainNav.insertBefore(item, moreMenu));
                moreMenu.style.display = 'none';
                return;
            }

            moreMenu.style.display = 'none'; 
            overflowLinks.innerHTML = '';    
            allLinks.forEach(item => mainNav.insertBefore(item, moreMenu)); 

            let navContainerWidth = mainNav.offsetWidth;
            let totalWidth = 0;
            const moreBtnWidth = 90; 

            for (let i = 0; i < allLinks.length; i++) {
                const item = allLinks[i];
                const itemStyle = window.getComputedStyle(item);
                const marginLeft = parseFloat(itemStyle.marginLeft) || 0;
                const marginRight = parseFloat(itemStyle.marginRight) || 0;
                totalWidth += item.offsetWidth + marginLeft + marginRight;

                if (totalWidth + moreBtnWidth > navContainerWidth) {
                    moreMenu.style.display = 'inline-block'; 
                    const remainingLinks = allLinks.slice(i);
                    remainingLinks.forEach(link => overflowLinks!.appendChild(link));
                    break; 
                }
            }
        };

        adjustNavItems();
        let resizeTimeout: number;
        window.addEventListener('resize', () => {
            clearTimeout(resizeTimeout);
            resizeTimeout = window.setTimeout(adjustNavItems, 100);
        });

        // 🔍 Supabase 資料庫即時模糊搜尋
        const searchModal = document.getElementById('searchModal');
        const closeSearchModalBtn = document.getElementById('closeSearchModalBtn');
        const globalSearchInput = document.getElementById('globalSearchInput') as HTMLInputElement | null;
        const searchResults = document.getElementById('searchResults');

        if (searchBtn && searchModal) {
            searchBtn.onclick = () => {
                searchModal.style.display = 'flex';
                if (globalSearchInput) {
                    globalSearchInput.value = '';
                    globalSearchInput.focus();
                }
                if (searchResults) searchResults.innerHTML = '<div style="color: #888; text-align: center; padding: 10px;">請輸入關鍵字搜尋...</div>';
            };
        }

        const closeSearch = () => {
            if (searchModal) searchModal.style.display = 'none';
        };

        if (closeSearchModalBtn) closeSearchModalBtn.onclick = closeSearch;
        if (searchModal) {
            searchModal.onclick = (e) => {
                if (e.target === searchModal) closeSearch();
            };
        }

        // 🔍 多資料表並行搜尋
        let searchTimer: number;
        if (globalSearchInput && searchResults) {
            globalSearchInput.oninput = (e) => {
                const query = (e.target as HTMLInputElement).value.trim();
                clearTimeout(searchTimer);

                if (!query) {
                    searchResults.innerHTML = '<div style="color: #888; text-align: center; padding: 10px;">請輸入關鍵字搜尋...</div>';
                    return;
                }

                searchResults.innerHTML = '<div style="color: #888; text-align: center; padding: 10px;">搜尋中...</div>';

                searchTimer = window.setTimeout(async () => {
                    let matches: { title: string; snippet: string; url: string }[] = [];

                    // 1. 先比對導覽列選單
                    allLinks.forEach(link => {
                        const title = link.textContent?.trim() || '';
                        const url = link.getAttribute('href') || '#';
                        if (title.toLowerCase().includes(query.toLowerCase())) {
                            matches.push({ title, snippet: `導覽選單: ${url}`, url });
                        }
                    });

                    // 2. 同時從多個 Supabase 資料表查詢
                    if (window.client) {
                        try {
                            const queries = [
                                window.client.from('posts').select('tasktitle, clientname, tasktag, taskdetails, reward, id').or(`tasktitle.ilike.%${query}%,clientname.ilike.%${query}%,tasktag.ilike.%${query}%,taskdetails.ilike.%${query}%,reward.ilike.%${query}%`).limit(5),
                                window.client.from('reading_clubs').select('title, content').or(`title.ilike.%${query}%,content.ilike.%${query}%`).limit(5),
                                window.client.from('events').select('title, details').or(`title.ilike.%${query}%,details.ilike.%${query}%`).limit(5)
                            ];

                            // 使用 Promise.all 同時發送所有查詢
                            const results = await Promise.all(queries);

                            results.forEach(({ data, error }, index) => {
                                if (!error && data) {
                                    data.forEach((item: any) => {
                                        if (index === 0) {
                                            // 第一張表：posts (萬事屋任務)
                                            const details = item.taskdetails || '';
                                            const taskTitle = item.tasktitle || '未命名任務';
                                            matches.push({
                                                title: taskTitle,
                                                snippet: `${details.length > 40 ? details.substring(0, 40) + '...' : details} | 報酬: ${item.reward || '無'}`,
                                                url: `/posts/${postId}`
                                            });
                                        } else if (index === 1) {
                                            // 第二張表：reading_clubs (讀書會 - 使用 [title].astro 動態路由)
                                            const content = item.content || '';
                                            const titleStr = item.title || '無標題';
                                            const encodedTitle = encodeURIComponent(titleStr);
                                            matches.push({
                                                title: titleStr,
                                                snippet: content.length > 50 ? content.substring(0, 50) + '...' : content,
                                                url: `/clubs/${encodedTitle}` // 👈 請根據你的實際資料夾路徑修改
                                            });
                                        } else {
                                            // 第三張表：events (活動)
                                            const details = item.details || '';
                                            const titleStr = item.title || '無標題';
                                            const encodedTitle = encodeURIComponent(titleStr);
                                            matches.push({
                                                title: titleStr,
                                                snippet: details.length > 50 ? details.substring(0, 50) + '...' : details,
                                                url: `/events/${encodedTitle}` // 👈 請根據你的實際資料夾路徑修改
                                            });
                                        }
                                    });
                                }
                            });
                        } catch (err) {
                            console.error('Supabase 多表搜尋連線異常:', err);
                        }
                    }

                    if (matches.length === 0) {
                        searchResults.innerHTML = '<div style="color: #888; text-align: center; padding: 10px;">找不到符合的內容</div>';
                    } else {
                        searchResults.innerHTML = matches.map(m => `
                            <a href="${m.url}" class="search-result-item" onclick="document.getElementById('searchModal').style.display='none';">
                                <strong>${m.title}</strong>
                                <div style="font-size: 0.85rem; color: #555; margin-top: 3px;">${m.snippet}</div>
                            </a>
                        `).join('');
                    }
                }, 300);
            };
        }
    };

    setupHeaderAuth();
    setupHeaderMenu();
</script>