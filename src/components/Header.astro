</div>

<!-- 🔍 全域資料庫搜尋彈窗 -->
<div id="searchModal" class="auth-modal" style="display: none;">
    <div class="auth-modal-content search-modal-content">
        <div class="search-modal-header">
            <h3>全站資料庫搜尋</h3>
            <button id="closeSearchModalBtn" class="search-close-btn">&times;</button>
        </div>
        <div class="auth-form-group">
            <input type="text" id="globalSearchInput" placeholder="輸入關鍵字搜尋讀書會、文章或標題..." />
        </div>
        <div id="searchResults" class="search-results-list"></div>
    </div>
</div>

<style>
    /* ==========================================================================
       樣式設定
       ========================================================================== */
    .header-navbar {
        width: 100%;
        background-color: #ffffff;
        border-bottom: 1px solid #EAEAEA;
        position: relative;
        z-index: 9000;
    }
    .header-navbar-container {
        max-width: 1600px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0px 50px;
    }
    .header-logo-area {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 10px 0px;
    }
    .header-logo-icon img { max-height: 50px; width: auto; }
    .header-logo-link:hover { cursor: pointer; opacity: 0.8; transition: opacity 0.2s; }

    .admin-icon-btn {
        background: none; border: none; cursor: pointer; padding: 5px;
        display: flex; align-items: center; transition: transform 0.1s;
